- content_for :searchbar do
  = render 'layouts/searchbar', placeholder: Organisation.model_name.human
  javascript:
    document.getElementById("searchbar_query").addEventListener("input", (event) => {
      const q = event.target.value.toLowerCase();
      if(q.lenght <= 3) return;
      
      for (const row of document.querySelectorAll("tbody tr")) {
        const cell = row.querySelector("td");
        if (cell) row.style.display = cell.textContent.toLowerCase().includes(q) ? "" : "none";
      }
    })
  
.container 
  .row
    .table-responsive
      table.table.table-hover.align-middle
        thead
          tr
            th= Organisation.model_name.human
            th= Organisation.human_attribute_name(:email)
            th= Booking.model_name.human(count: 2)
            th


        tbody.shadow-sm
          - @organisations.each do |organisation|
            tr
              td= link_to organisation.name, manage_root_path(org: organisation)
              td= mail_to organisation.email, organisation.email
              td
                = link_to manage_bookings_path(org: organisation.slug)
                  = organisation.bookings.where(concluded: false).count
                  span.my-1 
                    | /
                  = organisation.bookings.count
              td.py-1.text-end
                .btn-group
                = link_to edit_manage_organisation_path(org: organisation.slug), class: 'btn btn-default text-primary'
                  span.fa.fa-cog.pe-2
                  = Organisation.model_name.human
