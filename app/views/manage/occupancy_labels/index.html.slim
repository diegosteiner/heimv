
h1.mt-0.mb-5= OccupancyLabel.model_name.human(count: 2)

.table-responsive
  table.table.table-hover.align-middle

    tbody.shadow-sm
      - @occupancy_labels.each do |occupancy_label|
        tr.bg-white[class=('disabled' if occupancy_label.discarded?)]
          td
            span[style="color: #{occupancy_label.color}"]
              | ⬤
          td
            = link_to occupancy_label.title, edit_manage_occupancy_label_path(occupancy_label)
          td
            - if occupancy_label.occupancy_status_default.present?
              = Occupancy.human_enum(:occupancy_status, occupancy_label.occupancy_status_default)
          td
            small= occupancy_label.description
          td.p-1.text-end 
            .btn-group
              - unless occupancy_label.discarded?
                = link_to edit_manage_occupancy_label_path(occupancy_label), class: 'btn btn-default' do
                  span.fa.fa-edit
              = link_to manage_occupancy_label_path(occupancy_label), data: { confirm: t(:confirm) }, method: :delete, title: t(:destroy), class: 'btn btn-default' do
                span.fa.fa-trash

br
= link_to new_manage_occupancy_label_path, class: 'btn btn-primary' do
  span.fa.fa-file-o
  '
  = t(:add_record, model_name: BookingCategory.model_name.human)
