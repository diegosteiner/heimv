= form_with(model: [:manage, @calendar_label], local: true) do |f|

  fieldset
    ul.nav.nav-tabs.mt-4 role="tablist"
      - I18n.available_locales.each do |locale|
        - current_locale = locale == I18n.locale
        li.nav-item
          = link_to locale.upcase, "#title-#{locale}-tab",
            class: "nav-link #{'active' if current_locale}",
            aria: { controls: "title-#{locale}-tab", selected: current_locale },
            data: { "bs-toggle": 'tab' }, role: 'tab'
    .tab-content
      - I18n.available_locales.each do |locale|
        - current_locale = locale == I18n.locale
        .tab-pane.pt-3[id="title-#{locale}-tab" class="#{'show active' if current_locale}" aria-labelledby="title-#{locale}-tab" role='tabpanel']
          = f.text_field "title_#{locale.to_s}", label: CalendarLabel.human_attribute_name(:title)
          = f.text_area "description_#{locale.to_s}", label: CalendarLabel.human_attribute_name(:description)

    = f.color_field :color
    = f.select :occupancy_status_default, Occupancy.occupancy_statuses.keys.map { [Occupancy.human_enum(:occupancy_status, it), it] }, include_blank: true

  .form-actions.pt-4.mt-3
    = f.submit class: 'btn btn-primary'
    = link_to t(:back), manage_calendar_labels_path, class: 'btn btn-default'
