
h1.mt-0.mb-5= CalendarLabel.model_name.human(count: 2)

.table-responsive
  table.table.table-hover.align-middle
    thead
      tr
        th
        th= CalendarLabel.human_attribute_name(:title)
        th= CalendarLabel.human_attribute_name(:conflict_type_default)
        th= CalendarLabel.human_attribute_name(:booking_category_default)
        th= CalendarLabel.human_attribute_name(:description)
        th

    tbody.shadow-sm
      - @calendar_labels.each do |calendar_label|
        tr.bg-white[class=('disabled' if calendar_label.discarded?)]
          td
            span[style="color: #{calendar_label.color}"]
              | ⬤
          td
            = link_to calendar_label.title, edit_manage_calendar_label_path(calendar_label)
          td
            - if calendar_label.conflict_type_default.present?
              = Occupancy.human_enum(:conflict_type, calendar_label.conflict_type_default)
          td
            = calendar_label.booking_category_default&.title
          td
            small= calendar_label.description
          td.p-1.text-end 
            .btn-group
              - unless calendar_label.discarded?
                = link_to edit_manage_calendar_label_path(calendar_label), class: 'btn btn-default' do
                  span.fa.fa-edit
              = link_to manage_calendar_label_path(calendar_label), data: { confirm: t(:confirm) }, method: :delete, title: t(:destroy), class: 'btn btn-default' do
                span.fa.fa-trash

br
= link_to new_manage_calendar_label_path, class: 'btn btn-primary' do
  span.fa.fa-file-o
  '
  = t(:add_record, model_name: CalendarLabel.model_name.human)
