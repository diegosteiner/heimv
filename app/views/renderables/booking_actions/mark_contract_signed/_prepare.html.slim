
.row.justify-content-center
  .col-lg-8
    .card.shadow-sm
      .card-body
        h2.mt-0= @booking_action.label
        = form_with(url: invoke_path, method: :POST, local: true) do |f|
          - if @booking.contract.signed_pdf.attached?
            .mb-3= link_to @booking.contract.signed_pdf.filename, rails_blob_path(@booking.contract.signed_pdf), download: true
          - else 
            = f.file_field :signed_pdf, label: Contract.human_attribute_name(:signed_pdf), help: t(:optional)

          = f.button name: :id, value: @booking_action.key, type: :submit, class: 'btn btn-primary', data: { disable_with: @booking_action.label }
            = @booking_action.label
          = link_to t(:back), back_path, class: 'btn btn-outline-primary ms-2'
